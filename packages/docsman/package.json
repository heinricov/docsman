{
  "name": "docsman",
  "version": "0.0.6",
  "description": "Reusable React layouts and sidebar components built with Base UI, shadcn-style, and Tailwind CSS v4.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "keywords": [
    "react",
    "layouts",
    "sidebar",
    "tailwindcss",
    "base-ui",
    "shadcn"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.37.0",
    "next-themes": "^0.4.6",
    "react-icons": "^5.7.0",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "next": "^14.0.0 || ^15.0.0 || ^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@turbo/gen": "^2.9.15",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@workspace/eslint-config": "*",
    "@workspace/typescript-config": "*",
    "eslint": "^9",
    "tailwindcss": "^4",
    "tsup": "^8.3.5",
    "typescript": "^5"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "postcss.config.mjs",
    "README.md",
    "publish.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./globals.css": "./dist/globals.css",
    "./colors-styles.css": "./dist/colors-styles.css",
    "./sidebar-styles.css": "./dist/sidebar-styles.css",
    "./postcss.config": "./postcss.config.mjs",
    "./lib/*": "./dist/lib/*.js",
    "./hooks/*": "./dist/hooks/*.js",
    "./ui/*": {
      "source": "./src/ui/*.tsx",
      "import": "./dist/ui/*.js"
    },
    "./layouts": {
      "types": "./dist/layouts/index.d.ts",
      "import": "./dist/layouts/index.js"
    },
    "./layouts/*": "./dist/layouts/*.js",
    "./navigations/*": "./dist/navigations/*.js"
  }
}
